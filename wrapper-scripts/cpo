#!/bin/bash
# Wrapper script for copy-previous-output.py
# Provides alias 'cpo' and configurable path via environment variable

# Use environment variable SCRIPT_PATH if set, otherwise default
SCRIPT_PATH="${SCRIPT_PATH:-/home/lauri/github/python-scripts/copy-previous-output.py}"

if [ ! -f "$SCRIPT_PATH" ]; then
    echo "Error: Script not found at $SCRIPT_PATH"
    echo "Set SCRIPT_PATH environment variable to correct path"
    exit 1
fi

python3 "$SCRIPT_PATH" "$@"
